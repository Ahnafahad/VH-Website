# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files - NEVER commit these!
# Contains sensitive API keys and secrets
.env
.env.*
*.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.vercel-production
!.env.example

# Database files
*.db
*.db-journal
*.sqlite
*.sqlite3

# IDE settings
.idea/
.vscode/
*.swp
*.swo

# vercel
.vercel

# local-only dev tools (never pushed — see scripts/dev-login.sh header)
scripts/dev-login.sh

# typescript
*.tsbuildinfo
next-env.d.ts

# auto-generated files
/src/lib/generated-access-control.ts

# documentation with sensitive data
docs/claude-docs/
win-roots.pem

# Capacitor / Android build outputs (keep android/ source, ignore build artifacts)
android/.gradle/
android/app/build/
android/build/
android/local.properties
*.keystore
*.jks

# --- Session debris: screenshots, logs, one-off scripts. Never belong in git ---
/*.png
/*.jpg
/*.jpeg
/*.log
/build_log.txt
/deploy_*.txt
/*.ps1
/.design-ref-*
/take-screenshots.js
/tmp-playwright-script.js
/.playwright-mcp/
/.tmp/
/snapshots/
/videos/
/test-content/

# next-pwa writes these into public/ on every build (next.config.ts dest:"public").
# Regenerated by the Vercel build - committing them only creates churn.
/public/sw.js
/public/sw.js.map
/public/workbox-*.js
/public/workbox-*.js.map
/public/worker-*.js

# Claude Code local tool permissions - machine-specific
/.claude/settings.local.json
